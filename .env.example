# -------------------------------------------------------------
# ReleaseAnalyzer Environment Configuration Template
# -------------------------------------------------------------
# Copy this file to `server/.env` and `client/.env` and fill in the values.
# Do NOT commit the actual `.env` files.

# --- SERVER ---
# PostgreSQL Connection URL (e.g., Supabase transaction pooler for Render)
DATABASE_URL=

# Google Gemini API Key for AI Analysis
GEMINI_API_KEY=

# Primary and Fallback Gemini Models (e.g., gemini-3.7-flash)
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Backend server port
PORT=

# Allowed CORS origin (the URL of the frontend)
CLIENT_ORIGIN=


# --- CLIENT ---
# The URL of the backend API (used during production build)
VITE_API_URL=
